# Server
NEURALFORGE_HOST=127.0.0.1
NEURALFORGE_PORT=8000
NEURALFORGE_RELOAD=true

# CORS
NEURALFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
NEURALFORGE_LOG_LEVEL=INFO
NEURALFORGE_LOG_FILE=logs/neuralforge.log

# Database
NEURALFORGE_DATABASE_URL=sqlite:///data/neuralforge.db

# Storage paths (relativi a backend/)
NEURALFORGE_DATA_DIR=data
NEURALFORGE_UPLOADS_DIR=data/uploads
NEURALFORGE_DATASETS_DIR=data/datasets
NEURALFORGE_MODELS_DIR=data/models
NEURALFORGE_ADAPTERS_DIR=data/adapters
